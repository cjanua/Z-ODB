# ─── Dropbox PKCE (register in Dropbox App Console — no secret needed) ─────
# PKCE flow: only APP_KEY is required in the frontend
VITE_DROPBOX_APP_KEY=your_dropbox_app_key_here

# Dropbox folder containing OBD Fusion CSV logs
# Usually: /Apps/OBD Fusion/<your-app-folder>
VITE_DROPBOX_FOLDER=/Apps/OBD Fusion

# ─── Python CLI tools (server-side / local pull, not shipped to browser) ────
DROPBOX_APP_KEY=your_dropbox_app_key_here
DROPBOX_APP_SECRET=your_dropbox_app_secret_here
DROPBOX_REFRESH_TOKEN=
FUSION_DBX_PATH=/Apps/OBD Fusion
MY_VIN=your_vin_here

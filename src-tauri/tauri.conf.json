{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Z OBD Dashboard",
  "version": "0.1.0",
  "identifier": "com.z.obd",

  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "bun run dev-web",
    "beforeBuildCommand": "bun run build"
  },

  "app": {
    "windows": [
      {
        "title": "Z OBD Dashboard",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null,
      "dangerousDisableAssetCspModification": false
    }
  },

  "bundle": {
    "active": true,
    "targets": "all",
    "identifier": "com.z.obd",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "iOS": {
      "developmentTeam": ""
    }
  },

  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["z"]
      },
      "mobile": {
        "schemes": ["z"]
      }
    }
  }
}
